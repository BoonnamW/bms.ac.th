<%- include('_head') %>
<%
  var applyUrl = S.admission_link || '/contact';
  var about = nav.find(function (n) { return n.en === 'About'; });
  var aboutUrl = (about && (about.href || (about.children && about.children[0].href))) || '/contact';
  var fmt = function (n) { return Number(n || 0).toLocaleString('th-TH'); };
  var feat = news[0], rest = news.slice(1, 4);
%>

<section class="hero" id="hero" aria-roledescription="carousel" aria-label="ภาพประชาสัมพันธ์">
  <% slides.forEach(function (s, i) { %>
  <div class="slide <%= i === 0 ? 'on' : '' %>" role="group" aria-roledescription="slide" aria-label="<%= i + 1 %> จาก <%= slides.length %>">
    <img class="slide-img" src="<%= s.image ? '/uploads/' + s.image : '/img/hero.jpg' %>" alt="" data-fallback="/img/hero.jpg" <%= i ? 'loading=lazy' : 'fetchpriority=high' %>>
    <div class="slide-shade"></div>
    <div class="wrap slide-in">
      <span class="eyebrow"><%= S.school_name_en %></span>
      <% if (i === 0) { %><h1><%= s.title %></h1><% } else { %><h2 class="h1"><%= s.title %></h2><% } %>
      <% if (i === 0 && S.tagline) { %><p class="motto">“<%= S.tagline %>”</p><% } %>
      <% if (s.subtitle) { %><p class="hero-sub"><%= s.subtitle %></p><% } %>
      <div class="hero-btns">
        <% if (i === 0) { %>
          <a class="hbig hbig-primary" href="<%= aboutUrl %>"><%- icon('building', 22) %><span><b>เกี่ยวกับโรงเรียน</b><small>About Our School</small></span><%- icon('arrow', 18) %></a>
          <a class="hbig hbig-glass" href="/data"><%- icon('chart', 22) %><span><b>School Data Center</b><small>ข้อมูลสารสนเทศโรงเรียน</small></span><%- icon('arrow', 18) %></a>
        <% } else if (s.link) { %>
          <a class="hbig hbig-primary" href="<%= s.link %>"><%- icon('arrow', 22) %><span><b>ดูรายละเอียด</b><small>Learn More</small></span></a>
        <% } %>
      </div>
    </div>
    <% if (i === 0) { %><div class="hero-welcome" aria-hidden="true"><span><%= S.school_name %></span><b>ยินดีต้อนรับ</b></div><% } %>
  </div>
  <% }) %>
  <% if (slides.length > 1) { %>
  <div class="hero-ctrl">
    <button type="button" class="arrow" id="prev" aria-label="ภาพก่อนหน้า"><%- icon('left', 22) %></button>
    <div class="dots" id="dots"><% slides.forEach(function (s, i) { %><button type="button" aria-label="ภาพที่ <%= i + 1 %>" class="<%= i === 0 ? 'on' : '' %>"></button><% }) %></div>
    <button type="button" class="arrow" id="next" aria-label="ภาพถัดไป"><%- icon('right', 22) %></button>
  </div>
  <% } %>
</section>

<% if (links.length) { %>
<section class="quick-wrap" aria-label="เมนูลัด">
  <div class="wrap">
    <div class="quick">
      <% links.forEach(function (l, i) { %>
      <a class="q t<%= i % 6 %>" href="<%= l.url %>"><span class="q-ic"><%- icon(l.icon || 'star', 24) %></span>
        <span class="q-t"><b><%= l.title %></b><% if (l.subtitle) { %><small><%= l.subtitle %></small><% } %></span></a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (stats.length) { %>
<section class="wrap stats-row" aria-label="ข้อมูลโรงเรียนโดยสรุป">
  <% stats.forEach(function (s, i) { %>
  <div class="statc reveal t<%= i % 6 %>">
    <span class="s-ic"><%- icon(s.icon || 'star', 26) %></span>
    <div>
      <strong><span class="count" data-to="<%= s.value %>"><%= fmt(s.value) %></span><%= s.suffix || '' %></strong>
      <span class="s-l"><%= s.label %></span>
      <% if (s.label_en) { %><small><%= s.label_en %></small><% } %>
    </div>
  </div>
  <% }) %>
</section>
<% } %>

<section class="sec">
  <div class="wrap grid-news">
    <div>
      <div class="sec-h">
        <div><h2>ข่าวสารและกิจกรรมล่าสุด</h2><p class="en">Latest News</p></div>
        <a class="more" href="/news">ดูทั้งหมด <%- icon('arrow', 16) %></a>
      </div>
      <div class="tabs" id="newsTabs" role="group" aria-label="เลือกหมวดข่าว">
        <a href="/news" data-cat="" class="on" aria-current="true">ทั้งหมด</a>
        <% cats.slice(0, 6).forEach(function (c) { %><a href="/news?cat=<%= encodeURIComponent(c) %>" data-cat="<%= c %>"><%= c %></a><% }) %>
      </div>
      <div class="news-feat" id="newsFeat" aria-live="polite">
        <% if (feat) { %>
        <article class="nf-main">
          <a class="nf-img" href="/news/<%= feat.id %>" tabindex="-1" aria-hidden="true">
            <% if (feat.image) { %><img src="/uploads/<%= feat.image %>" alt="" loading="lazy"><% } else { %><div class="ph ph-<%= feat.id % 5 %>"><%- icon('book', 48) %></div><% } %>
          </a>
          <p class="meta-row"><span class="chip"><%= feat.category %></span><time><%= thDate(feat.created_at) %></time></p>
          <h3><a href="/news/<%= feat.id %>"><%= feat.title %></a></h3>
          <% if (feat.excerpt) { %><p class="ex"><%= feat.excerpt %></p><% } %>
          <a class="readmore" href="/news/<%= feat.id %>">อ่านต่อ <%- icon('arrow', 15) %></a>
        </article>
        <div class="nf-list">
          <% rest.forEach(function (n) { %>
          <article class="nf-item">
            <a class="nf-thumb" href="/news/<%= n.id %>" tabindex="-1" aria-hidden="true">
              <% if (n.image) { %><img src="/uploads/<%= n.image %>" alt="" loading="lazy"><% } else { %><div class="ph ph-<%= n.id % 5 %>"><%- icon('book', 26) %></div><% } %>
            </a>
            <div>
              <p class="meta-row"><span class="chip"><%= n.category %></span><time><%= thDate(n.created_at) %></time></p>
              <h3><a href="/news/<%= n.id %>"><%= n.title %></a></h3>
            </div>
          </article>
          <% }) %>
        </div>
        <% } else { %><p class="empty">ยังไม่มีข่าว</p><% } %>
      </div>
    </div>

    <aside class="panel ev-panel" aria-labelledby="evTitle">
      <div class="sec-h sm">
        <div><h2 id="evTitle">ปฏิทินกิจกรรม</h2><p class="en">Upcoming Events</p></div>
        <a class="more" href="/calendar">ดูทั้งหมด <%- icon('arrow', 16) %></a>
      </div>
      <% if (events.length) { %>
        <ul class="ev-list"><% events.forEach(function (e) { %><%- include('_event', { e: e }) %><% }) %></ul>
      <% } else { %>
        <div class="ev-empty"><%- icon('calendar', 34) %><p>ยังไม่มีกิจกรรมที่กำลังจะมาถึง</p><a href="/calendar">ดูปฏิทินกิจกรรม</a></div>
      <% } %>
      <a class="ical" href="/calendar#subscribe"><%- icon('rss', 15) %> ติดตามปฏิทินโรงเรียน (iCal)</a>
    </aside>
  </div>
</section>

<% if (programs.length || highlights.length) { %>
<section class="sec sec-alt">
  <div class="wrap grid-news">
    <% if (programs.length) { %>
    <div>
      <div class="sec-h">
        <div><h2>หลักสูตรและการเรียนรู้</h2><p class="en">Academics &amp; Programs</p></div>
        <a class="more" href="/academics">ดูทั้งหมด <%- icon('arrow', 16) %></a>
      </div>
      <div class="prog-grid">
        <% programs.forEach(function (p, i) { %>
        <a class="prog reveal" href="<%= p.link || '/academics' %>">
          <span class="prog-img"><% if (p.image) { %><img src="/uploads/<%= p.image %>" alt="" loading="lazy"><% } else { %><span class="ph ph-<%= i % 5 %>"><%- icon('book', 36) %></span><% } %></span>
          <span class="prog-b"><b><%= p.title %></b><% if (p.title_en) { %><small><%= p.title_en %></small><% } %>
            <% if (p.summary) { %><span class="ex"><%= p.summary %></span><% } %></span>
          <span class="go" aria-hidden="true"><%- icon('right', 16) %></span>
        </a>
        <% }) %>
      </div>
    </div>
    <% } %>
    <% if (highlights.length) { %>
    <div>
      <div class="sec-h">
        <div><h2>ทำไมต้องเลือก<%= S.school_name %></h2><p class="en">Why Choose Us</p></div>
      </div>
      <div class="hl-grid">
        <% highlights.forEach(function (h, i) { %>
        <div class="hl reveal t<%= i % 6 %>"><span class="hl-ic"><%- icon(h.icon || 'star', 22) %></span><div><b><%= h.title %></b><% if (h.subtitle) { %><small><%= h.subtitle %></small><% } %></div></div>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>
</section>
<% } %>

<% if (awards.some(function (g) { return g.items.length; })) { %>
<section class="sec aw-sec" aria-labelledby="awTitle">
  <div class="wrap">
    <div class="sec-h">
      <div><h2 id="awTitle">ผลงานและความภาคภูมิใจ</h2><p class="en">Achievements &amp; Awards</p></div>
      <a class="more" href="/awards">ดูทั้งหมด <%- icon('arrow', 16) %></a>
    </div>
    <div class="aw-grid">
      <% awards.forEach(function (g) { %>
      <div class="aw-card aw-<%= g.key %> reveal">
        <div class="aw-head">
          <span class="aw-ic"><%- icon(awardIcons[g.key], 20) %></span>
          <h3><%= g.title %></h3>
          <a class="aw-all" href="/awards?owner=<%= g.key %>">ดูทั้งหมด<span class="sr-only"> (<%= g.title %>)</span> <%- icon('arrow', 14) %></a>
        </div>
        <% if (g.items.length) { %>
        <ul class="aw-list">
          <% g.items.forEach(function (a) { var sub = [awardLevels[a.level], a.people].filter(Boolean).join(' · ') || thDay(a.award_date); %>
          <li>
            <span class="aw-year"><%= a.award_date ? 'พ.ศ. ' + (Number(a.award_date.slice(0, 4)) + 543) : '' %></span>
            <span class="aw-b">
              <% if (a.link) { %><a href="<%= a.link %>"<% if (/^https?:/.test(a.link)) { %> target="_blank" rel="noopener"<% } %>><%= a.title %></a><% } else { %><b><%= a.title %></b><% } %>
              <% if (sub) { %><small><%= sub %></small><% } %>
            </span>
          </li>
          <% }) %>
        </ul>
        <% } else { %>
        <p class="aw-empty"><%- icon('award', 28) %>ยังไม่มีผลงานในหมวดนี้</p>
        <% } %>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (albums.length || gallery.length) { %>
<section class="sec">
  <div class="wrap">
    <div class="sec-h">
      <div><h2>ภาพกิจกรรมและชีวิตในโรงเรียน</h2><p class="en">Student Life Gallery</p></div>
      <a class="more" href="/gallery">ดูทั้งหมด <%- icon('arrow', 16) %></a>
    </div>
    <div class="slider gal" data-slider>
      <button type="button" class="sl-btn" data-prev aria-label="ภาพก่อนหน้า"><%- icon('left', 20) %></button>
      <div class="sl-track" tabindex="0" aria-label="ภาพกิจกรรม (เลื่อนดูได้)">
        <% albums.forEach(function (a) { %>
        <a class="gal-item" href="<%= a.href %>">
          <img src="<%= a.image %>" alt="" loading="lazy">
          <% if (a.n > 1) { %><span class="album-n"><%- icon('image', 14) %> <%= a.n.toLocaleString('th-TH') %> ภาพ</span><% } %>
          <span class="gal-cap"><%= a.title %></span>
        </a>
        <% }) %>
        <% if (!albums.length) gallery.forEach(function (g, i) { %>
        <a class="gal-item" href="/gallery">
          <% if (g.image) { %><img src="/uploads/<%= g.image %>" alt="" loading="lazy"><% } else { %><span class="ph ph-<%= i % 5 %>"><%- icon('image', 36) %></span><% } %>
          <span class="gal-cap"><%= g.title %></span>
        </a>
        <% }) %>
      </div>
      <button type="button" class="sl-btn" data-next aria-label="ภาพถัดไป"><%- icon('right', 20) %></button>
    </div>
  </div>
</section>
<% } %>

<section class="sec sec-alt">
  <div class="wrap grid-2">
    <% if (tour && tour.embed) { %>
    <div class="tour" id="tour">
      <img class="tour-bg" src="/img/hero.jpg" alt="" loading="lazy">
      <div class="tour-in">
        <span class="eyebrow">Virtual Campus Tour</span>
        <h2>เยี่ยมชมโรงเรียนแบบออนไลน์</h2>
        <p>ชมบรรยากาศและสถานที่ภายใน<%= S.school_name %></p>
        <button type="button" class="hbig hbig-primary" data-video="<%= tour.embed %>"><%- icon('play', 22) %><span><b>เริ่มชมวิดีโอ</b><small>โหลดจาก YouTube เมื่อกดเล่น</small></span></button>
      </div>
    </div>
    <% } else { %>
    <div class="tour">
      <img class="tour-bg" src="/img/hero.jpg" alt="" loading="lazy">
      <div class="tour-in">
        <span class="eyebrow">About Us</span>
        <h2><%= S.about_title %></h2>
        <p><%= S.about_text %></p>
        <% if (tour && tour.url) { %>
          <a class="hbig hbig-primary" href="<%= tour.url %>" target="_blank" rel="noopener"><%- icon('play', 22) %><span><b>ชมวิดีโอแนะนำโรงเรียน</b><small>Virtual Tour</small></span></a>
        <% } else { %>
          <a class="hbig hbig-primary" href="<%= aboutUrl %>"><%- icon('building', 22) %><span><b>ทำความรู้จักโรงเรียน</b><small>About Our School</small></span><%- icon('arrow', 18) %></a>
        <% } %>
      </div>
    </div>
    <% } %>

    <div class="dc-card">
      <div class="dc-h">
        <div><h2>School Data Center</h2><p>ศูนย์ข้อมูลสารสนเทศโรงเรียน</p></div>
        <a class="btn btn-white btn-sm" href="/data">ดูข้อมูลทั้งหมด <%- icon('arrow', 15) %></a>
      </div>
      <div class="dc-grid">
        <% data.stats.slice(0, 2).forEach(function (s) { %>
        <div class="dc-tile"><span class="dc-l"><%= s.label %></span><strong><%= fmt(s.value) %><%= s.suffix || '' %></strong><small><%= s.label_en %></small></div>
        <% }) %>
        <% if (data.perYear.length) { var mx = Math.max.apply(null, data.perYear.map(function (y) { return y.n; })); var last = data.perYear[data.perYear.length - 1]; %>
        <div class="dc-tile">
          <span class="dc-l">ข่าวและประกาศ</span><strong><%= fmt(data.newsTotal) %></strong>
          <span class="spark" role="img" aria-label="จำนวนข่าวต่อปี พ.ศ. <%= data.perYear[0].year %>–<%= last.year %> ปีล่าสุด <%= last.n %> เรื่อง">
            <% data.perYear.forEach(function (y, k) { %><span class="sb h-<%= Math.max(4, Math.round(y.n / mx * 100)) %> <%= k === data.perYear.length - 1 ? 'cur' : '' %>"></span><% }) %>
          </span>
        </div>
        <% } %>
        <% if (data.oit.total) { %>
        <a class="dc-tile dc-link" href="/ita">
          <span class="dc-l">เปิดเผยข้อมูลสาธารณะ</span><strong><%= data.oit.total %><small class="of"> หัวข้อ</small></strong>
          <small>ITA / OIT <%- icon('arrow', 13) %></small>
        </a>
        <% } %>
      </div>
    </div>
  </div>
</section>

<section class="sec sec-tight">
  <div class="wrap">
    <div class="sec-h"><div><h2>ติดตามโรงเรียนในช่องทางต่าง ๆ</h2><p class="en">Stay Connected</p></div></div>
    <div class="conn-grid">
      <% if (S.facebook) { %>
      <a class="conn" href="<%= S.facebook %>" target="_blank" rel="noopener"><span class="conn-ic t0"><%- icon('broadcast', 24) %></span>
        <span><b>Facebook และถ่ายทอดสดกิจกรรม</b><small>ติดตามข่าวและการถ่ายทอดสดกิจกรรมของโรงเรียน</small></span><%- icon('arrow', 18) %></a>
      <% } %>
      <a class="conn" href="/calendar#subscribe"><span class="conn-ic t1"><%- icon('calendar', 24) %></span>
        <span><b>ปฏิทินกิจกรรม (iCal)</b><small>เพิ่มปฏิทินโรงเรียนลงในโทรศัพท์ แจ้งเตือนอัตโนมัติ</small></span><%- icon('arrow', 18) %></a>
      <a class="conn" href="/contact"><span class="conn-ic t2"><%- icon('help', 24) %></span>
        <span><b>สอบถาม / ร้องเรียน</b><small>ส่งข้อความถึงโรงเรียน เจ้าหน้าที่จะติดต่อกลับ</small></span><%- icon('arrow', 18) %></a>
    </div>
  </div>
</section>

<section class="cta-band">
  <img class="cta-bg" src="/img/hero.jpg" alt="" loading="lazy">
  <div class="wrap cta-in">
    <div>
      <span class="eyebrow"><%= S.school_name_en %></span>
      <h2><%= S.school_name %> ยินดีต้อนรับ</h2>
      <p><%= S.admission_text %></p>
    </div>
    <div class="cta-btns">
      <a class="cbtn c-white" href="<%= applyUrl %>"><%- icon('graduation', 22) %><span><b>สมัครเรียน</b><small>Apply Now</small></span></a>
      <a class="cbtn c-dark" href="/contact?topic=visit"><%- icon('calendar', 22) %><span><b>นัดเยี่ยมชมโรงเรียน</b><small>Book a Visit</small></span></a>
      <a class="cbtn c-glass" href="/contact"><%- icon('mail', 22) %><span><b>ติดต่อเรา</b><small>Contact Us</small></span></a>
    </div>
  </div>
</section>

<% if (popup) { var pimg = popup.image ? '/uploads/' + popup.image : ''; %>
<dialog class="popup" id="popup" data-key="<%= popup.key %>" data-frequency="<%= popup.frequency || 'session' %>" aria-labelledby="popupTitle">
  <button type="button" class="popup-x" data-close aria-label="ปิดหน้าต่างนี้"><%- icon('x', 20) %></button>
  <% if (pimg) { %>
    <% if (popup.link) { %><a class="popup-img" href="<%= popup.link %>"><img src="<%= pimg %>" alt="<%= popup.title %>"></a>
    <% } else { %><span class="popup-img"><img src="<%= pimg %>" alt="<%= popup.title %>"></span><% } %>
  <% } else { %>
    <div class="popup-hero">
      <img src="/img/hero.jpg" alt="">
      <span class="popup-brand"><img src="<%= S.logo ? '/uploads/' + S.logo : '/img/icon-192.png' %>" alt="" data-fallback="/img/icon-192.png"><span><%= S.school_name %><small><%= S.school_name_en %></small></span></span>
    </div>
  <% } %>
  <div class="popup-b">
    <h2 id="popupTitle"><%= popup.title %></h2>
    <% if (popup.body) { %><p><%= popup.body %></p><% } %>
    <div class="popup-btns">
      <% if (popup.link) { %><a class="btn btn-ghost" href="<%= popup.link %>"><%= popup.link_text || 'ดูรายละเอียด' %></a><% } %>
      <button type="button" class="btn btn-primary" data-close autofocus>เข้าสู่เว็บไซต์ <%- icon('arrow', 16) %></button>
    </div>
  </div>
</dialog>
<% } %>

<%- include('_foot') %>
