<%- include('_head') %>

<section class="hero" id="hero" aria-roledescription="carousel" aria-label="ภาพประชาสัมพันธ์">
  <% slides.forEach(function (s, i) { %>
  <div class="slide <%= i === 0 ? 'on' : '' %>" role="group" aria-roledescription="slide" aria-label="<%= i + 1 %> จาก <%= slides.length %>">
    <img class="slide-img" src="<%= s.image ? '/uploads/' + s.image : '/img/hero.jpg' %>" alt="" data-fallback="/img/hero.jpg" <%= i ? 'loading=lazy' : 'fetchpriority=high' %>>
    <div class="slide-shade"></div>
    <div class="wrap slide-in">
      <span class="eyebrow"><%= S.school_name_en %></span>
      <% if (i === 0) { %><h1><%= s.title %></h1><% } else { %><h2 class="h1"><%= s.title %></h2><% } %>
      <% if (i === 0 && S.tagline) { %><p class="motto">“<%= S.tagline %>”</p><% } %>
      <% if (s.subtitle) { %><p class="hero-sub"><%= s.subtitle %></p><% } %>
      <div class="hero-btns">
        <% if (i === 0) { %>
          <a class="hbig hbig-primary" href="<%= aboutUrl %>"><%- icon('building', 22) %><span><b>เกี่ยวกับโรงเรียน</b><small>About Our School</small></span><%- icon('arrow', 18) %></a>
          <a class="hbig hbig-glass" href="/data"><%- icon('chart', 22) %><span><b>School Data Center</b><small>ข้อมูลสารสนเทศโรงเรียน</small></span><%- icon('arrow', 18) %></a>
        <% } else if (s.link) { %>
          <a class="hbig hbig-primary" href="<%= s.link %>"><%- icon('arrow', 22) %><span><b>ดูรายละเอียด</b><small>Learn More</small></span></a>
        <% } %>
      </div>
    </div>
    <% if (i === 0) { %><div class="hero-welcome" aria-hidden="true"><span><%= S.school_name %></span><b>ยินดีต้อนรับ</b></div><% } %>
  </div>
  <% }) %>
  <% if (slides.length > 1) { %>
  <div class="hero-ctrl">
    <button type="button" class="arrow" id="prev" aria-label="ภาพก่อนหน้า"><%- icon('left', 22) %></button>
    <div class="dots" id="dots"><% slides.forEach(function (s, i) { %><button type="button" aria-label="ภาพที่ <%= i + 1 %>" class="<%= i === 0 ? 'on' : '' %>"></button><% }) %></div>
    <button type="button" class="arrow" id="next" aria-label="ภาพถัดไป"><%- icon('right', 22) %></button>
  </div>
  <% } %>
</section>

<% if (links.length) { %>
<section class="quick-wrap" aria-label="เมนูลัด">
  <div class="wrap">
    <div class="quick">
      <% links.forEach(function (l, i) { %>
      <a class="q t<%= i % 6 %>" href="<%= l.url %>"><span class="q-ic"><%- icon(l.icon || 'star', 24) %></span>
        <span class="q-t"><b><%= l.title %></b><% if (l.subtitle) { %><small><%= l.subtitle %></small><% } %></span></a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% sections.forEach(function (x) { %><%- include('home/_' + x.k, { alt: x.alt }) %>
<% }) %>

<% if (popup) {
  var pimg = popup.image ? (/^https:\/\//.test(popup.image) ? popup.image : '/uploads/' + popup.image) : '';
  var pstyle = ['poster', 'mourning'].indexOf(popup.style) >= 0 ? popup.style : 'card';
  if (pstyle === 'poster' && !pimg) pstyle = 'card'; // โปสเตอร์ต้องมีภาพ
  var psize = ['m', 'l', 'xl'].indexOf(popup.size) >= 0 ? popup.size : 'm';
  var ptitle = popup.show_title !== 0;
%>
<dialog class="popup p-<%= pstyle %> ps-<%= psize %>" id="popup" data-key="<%= popup.key %>" data-frequency="<%= popup.frequency || 'session' %>"
  <%= ptitle ? 'aria-labelledby=popupTitle' : '' %> aria-label="<%= popup.title %>">
  <button type="button" class="popup-x" data-close aria-label="ปิดหน้าต่างนี้"><%- icon('x', 20) %></button>
  <% if (pstyle === 'mourning' && pimg) { %><span class="popup-ribbon" aria-hidden="true"><%- ribbonSvg %></span><% } %>
  <% if (pimg) { %>
    <% if (popup.link) { %><a class="popup-img" href="<%= popup.link %>"><img src="<%= pimg %>" alt="<%= popup.title %>"></a>
    <% } else { %><span class="popup-img"><img src="<%= pimg %>" alt="<%= popup.title %>"></span><% } %>
  <% } else if (pstyle === 'mourning') { %>
    <div class="popup-mourn"><%- ribbonSvg %></div>
  <% } else { %>
    <div class="popup-hero">
      <img src="/img/hero.jpg" alt="">
      <span class="popup-brand"><img src="<%= S.logo ? '/uploads/' + S.logo : '/img/icon-192.png' %>" alt="" data-fallback="/img/icon-192.png"><span><%= S.school_name %><small><%= S.school_name_en %></small></span></span>
    </div>
  <% } %>
  <div class="popup-b">
    <% if (ptitle) { %><h2 id="popupTitle"><%= popup.title %></h2><% } %>
    <% if (popup.body) { %><p><%= popup.body %></p><% } %>
    <div class="popup-btns">
      <% if (popup.link) { %><a class="btn btn-ghost" href="<%= popup.link %>"><%= popup.link_text || 'ดูรายละเอียด' %></a><% } %>
      <button type="button" class="btn btn-primary" data-close autofocus>เข้าสู่เว็บไซต์ <%- icon('arrow', 16) %></button>
    </div>
    <% if (popup.preview) { %><p class="popup-prev"><%- icon('lock', 13) %> ตัวอย่างสำหรับผู้ดูแล — ผู้ชมเห็นตามช่วงเวลาที่ตั้งไว้</p><% } %>
  </div>
</dialog>
<% } %>

<%- include('_foot') %>
