<%- include('_head') %>
<%
  // ลิงก์ตัวกรอง: เปลี่ยนเฉพาะค่าที่ส่งมา ค่าอื่น (ประเภท/ปี/คำค้น) คงไว้
  var link = function (o) {
    var p = Object.assign({ owner: owner, year: year || '', q: q, page: '' }, o), out = [];
    ['owner', 'year', 'q', 'page'].forEach(function (k) { if (p[k]) out.push(k + '=' + encodeURIComponent(p[k])); });
    return '/awards' + (out.length ? '?' + out.join('&') : '');
  };
  var be = function (d) { return d ? Number(String(d).slice(0, 4)) + 543 : 0; };
  var sum = Object.keys(owners).reduce(function (s, k) { return s + (counts[k] || 0); }, 0);
  var groups = [];
  items.forEach(function (a) {
    var y = be(a.award_date);
    if (!groups.length || groups[groups.length - 1].year !== y) groups.push({ year: y, items: [] });
    groups[groups.length - 1].items.push(a);
  });
%>
<%- include('_pagehead', { heading: owner ? owners[owner] : 'ผลงานและรางวัล', eyebrow: 'Achievements & Awards',
  lead: 'ผลงานและความภาคภูมิใจของโรงเรียน ครูและบุคลากร และนักเรียน',
  crumbs: owner ? [['ผลงานและรางวัล', '/awards'], [owners[owner]]] : [['ผลงานและรางวัล']] }) %>
<section class="sec">
  <div class="wrap">
    <% if (editor) { %>
    <div class="staff-tools">
      <a class="btn btn-primary btn-sm" href="/admin/awards/new?owner=<%= owner || 'student' %>&back=<%= encodeURIComponent('/awards') %>"><%- icon('plus', 16) %> เพิ่มผลงาน</a>
      <a class="btn btn-ghost btn-sm" href="/admin/awards">จัดการผลงานทั้งหมด</a>
      <span class="muted small"><%- icon('lock', 14) %> แสดงเฉพาะผู้ดูแลที่เข้าสู่ระบบอยู่</span>
    </div>
    <% } %>

    <nav class="tabs aw-tabs" aria-label="ประเภทผลงาน">
      <a class="<%= owner ? '' : 'on' %>" href="<%= link({ owner: '' }) %>" <%= owner ? '' : 'aria-current=true' %>>ทั้งหมด <span class="n"><%= sum.toLocaleString('th-TH') %></span></a>
      <% Object.keys(owners).forEach(function (k) { %>
      <a class="aw-<%= k %><%= owner === k ? ' on' : '' %>" href="<%= link({ owner: k }) %>" <%= owner === k ? 'aria-current=true' : '' %>><%- icon(awardIcons[k], 15) %> <%= owners[k] %> <span class="n"><%= (counts[k] || 0).toLocaleString('th-TH') %></span></a>
      <% }) %>
    </nav>

    <form class="aw-filter" action="/awards" role="search">
      <% if (owner) { %><input type="hidden" name="owner" value="<%= owner %>"><% } %>
      <input type="search" name="q" value="<%= q %>" placeholder="ค้นหาชื่อผลงาน หรือชื่อผู้ได้รับรางวัล" aria-label="ค้นหาผลงาน" maxlength="60">
      <label class="sr-only" for="awYear">ปีที่ได้รับ (พ.ศ.)</label>
      <select id="awYear" name="year">
        <option value="">ทุกปี</option>
        <% years.forEach(function (y) { %><option value="<%= y %>" <%= y === year ? 'selected' : '' %>>พ.ศ. <%= y %></option><% }) %>
      </select>
      <button class="btn btn-primary btn-sm"><%- icon('search', 16) %> ค้นหา</button>
      <% if (year || q) { %><a class="aw-clear" href="<%= link({ year: '', q: '' }) %>"><%- icon('x', 14) %> ล้างตัวกรอง</a><% } %>
    </form>

    <% if (!items.length) { %>
    <div class="panel ev-empty big"><%- icon('award', 44) %>
      <p><%= year || q ? 'ไม่พบผลงานตามเงื่อนไขที่เลือก' : 'ยังไม่มีผลงานในหมวดนี้' %></p>
      <% if (year || q || owner) { %><a href="/awards">ดูผลงานทั้งหมด</a><% } %>
    </div>
    <% } else { %>
    <p class="aw-total muted">พบ <b><%= total.toLocaleString('th-TH') %></b> รายการ<%= pages > 1 ? ' · หน้า ' + page + ' จาก ' + pages : '' %></p>
    <% groups.forEach(function (g) { %>
    <section class="aw-yg" aria-labelledby="awy-<%= g.year %>">
      <h2 class="aw-yh" id="awy-<%= g.year %>"><%= g.year ? 'พ.ศ. ' + g.year : 'ไม่ระบุปี' %></h2>
      <ul class="aw-rows">
        <% g.items.forEach(function (a) { %>
        <li class="awr aw-<%= a.owner %>" id="aw-<%= a.id %>">
          <span class="awr-img"><% if (a.cover) { %><img src="<%= a.cover %>" alt="" loading="lazy" <%- imgset(a.cover, '112px') %>><% } %><%- icon(awardIcons[a.owner] || 'award', 26) %></span>
          <div class="awr-b">
            <p class="awr-meta">
              <span class="aw-badge"><%= owners[a.owner] || 'ผลงาน' %></span>
              <% if (awardLevels[a.level]) { %><span class="awr-lv"><%= awardLevels[a.level] %></span><% } %>
              <% if (a.award_date) { %><time datetime="<%= a.award_date %>"><%= thDay(a.award_date, 'short') %><%= a.award_time ? ' · ' + a.award_time + ' น.' : '' %></time><% } %>
            </p>
            <h3><a href="/awards/<%= a.id %>"><%= a.title %></a></h3>
            <% if (a.people) { %><p class="awr-people"><%- icon('user', 14) %> <%= a.people %></p><% } %>
            <% if (a.excerpt) { %><p class="awr-detail"><%= a.excerpt %></p><% } %>
            <% if (a.nPics || a.nDocs || a.drive_url) { %><p class="awr-has">
              <% if (a.nPics || a.drive_url) { %><span><%- icon('image', 14) %> <%= a.nPics ? a.nPics + ' รูป' : 'อัลบั้มภาพ' %></span><% } %>
              <% if (a.nDocs) { %><span><%- icon('file', 14) %> เอกสาร <%= a.nDocs %> ไฟล์</span><% } %>
            </p><% } %>
          </div>
          <% if (editor) { %><a class="person-edit" href="/admin/awards/<%= a.id %>?back=<%= encodeURIComponent('/awards') %>" aria-label="แก้ไข <%= a.title %>" title="แก้ไข"><%- icon('edit', 16) %></a><% } %>
        </li>
        <% }) %>
      </ul>
    </section>
    <% }) %>
    <% } %>
    <%- include('_pager', { page: page, pages: pages, href: function (n) { return link({ page: n > 1 ? n : '' }); } }) %>
  </div>
</section>
<%- include('_foot') %>
