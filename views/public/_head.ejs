<%
  // เมนูหลักที่ตรงกับหน้าปัจจุบัน (เลือกเพียงเมนูเดียว): ลิงก์ตรงทั้งหมด → path ตรง → หน้าย่อยของลิงก์
  var dec = function (u) { try { return decodeURIComponent(String(u || '')); } catch (e) { return String(u || ''); } };
  var hrefPath = function (h) { return dec(h).split(/[?#]/)[0]; };
  var here = dec(url), herePath = dec(path);
  var hrefsOf = function (it) { return [it.href].concat((it.children || []).map(function (c) { return c.href; })).filter(Boolean); };
  var findOn = function (test) { return nav.findIndex(function (it) { return hrefsOf(it).some(test); }); };
  var onIdx = findOn(function (h) { return dec(h) === here; });
  if (onIdx < 0) onIdx = findOn(function (h) { return hrefPath(h) === herePath; });
  if (onIdx < 0) onIdx = findOn(function (h) { var p = hrefPath(h); return p !== '/' && herePath.indexOf(p + '/') === 0; });
  var applyUrl = S.admission_link || '/contact';
  var logoSrc = S.logo ? '/uploads/' + S.logo : '/img/icon-192.png';
%><!doctype html>
<html lang="th"<% if (fs) { %> data-fs="<%= fs %>"<% } %><% if (hc) { %> class="hc"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? title + ' | ' : '' %><%= S.school_name %></title>
  <meta name="description" content="<%= S.school_name %> – <%= S.tagline %>">
  <meta name="theme-color" content="<%= S.primary %>">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/img/favicon-32.png" type="image/png">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <link rel="alternate" type="application/rss+xml" title="ข่าวสาร <%= S.school_name %>" href="/feed.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700&family=Prompt:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/theme.css">
  <link rel="stylesheet" href="/css/site.css?v=<%= v %>">
  <script src="/js/site.js?v=<%= v %>" defer></script>
</head>
<body>
<a class="skip" href="#main">ข้ามไปยังเนื้อหา</a>

<div class="topbar">
  <div class="wrap topbar-in">
    <div class="tb-l">
      <% if (S.agency) { %><span class="tb-agency"><%- icon('building', 14) %><%= S.agency %></span><% } %>
    </div>
    <div class="tb-r">
      <a href="/ita" class="hide-sm">ITA / OIT</a>
      <a href="/portal" class="hide-sm">e-Service</a>
      <% if (S.phone) { %><a href="tel:<%= S.phone.replace(/[^\d+]/g, '') %>" class="hide-xs"><%- icon('phone', 14) %><%= S.phone %></a><% } %>
      <% if (S.email) { %><a href="mailto:<%= S.email %>" class="hide-md"><%- icon('mail', 14) %><%= S.email %></a><% } %>
      <div class="a11y" role="group" aria-label="ขนาดตัวอักษร">
        <button type="button" data-fs="sm" aria-pressed="<%= fs === 'sm' %>" aria-label="ตัวอักษรเล็ก">A-</button>
        <button type="button" data-fs="md" aria-pressed="<%= !fs %>" aria-label="ตัวอักษรปกติ">A</button>
        <button type="button" data-fs="lg" aria-pressed="<%= fs === 'lg' %>" aria-label="ตัวอักษรใหญ่">A+</button>
        <button type="button" class="hc-btn" data-hc aria-pressed="<%= hc %>" aria-label="โหมดความคมชัดสูง" title="ความคมชัดสูง"><%- icon('contrast', 15) %></button>
      </div>
    </div>
  </div>
</div>

<header class="header" id="header">
  <div class="wrap header-in">
    <a class="brand" href="/">
      <img src="<%= logoSrc %>" alt="" width="58" height="58">
      <span class="brand-t"><strong><%= S.school_name %></strong><small><%= S.school_name_en %></small></span>
    </a>
    <div class="head-tools">
      <form class="hsearch" action="/search" role="search" id="hsearch">
        <%- icon('search', 17) %>
        <input type="search" name="q" id="q" placeholder="ค้นหาข้อมูล…" aria-label="ค้นหาข้อมูลในเว็บไซต์" autocomplete="off" maxlength="80"
          aria-controls="suggest" aria-expanded="false" aria-autocomplete="list">
        <kbd>Ctrl K</kbd>
        <div class="suggest" id="suggest" role="listbox" aria-label="ผลการค้นหา" hidden></div>
      </form>
      <a class="hbtn hbtn-portal" href="/portal"><%- icon('login', 20) %><span><b>เข้าสู่ระบบ</b><small>Portal Login</small></span></a>
      <a class="hbtn hbtn-apply" href="<%= applyUrl %>"><%- icon('graduation', 20) %><span><b>สมัครเรียน</b><small>Apply Now</small></span></a>
    </div>
    <button class="burger" id="burger" type="button" aria-label="เปิดเมนู" aria-expanded="false" aria-controls="nav"><span class="b-open"><%- icon('menu', 26) %></span><span class="b-close"><%- icon('x', 26) %></span></button>
  </div>
  <nav class="nav" id="nav" aria-label="เมนูหลัก">
    <div class="wrap">
      <form class="nav-search" action="/search" role="search">
        <input type="search" name="q" placeholder="ค้นหาข้อมูล…" aria-label="ค้นหาข้อมูลในเว็บไซต์" maxlength="80">
        <button aria-label="ค้นหา"><%- icon('search', 18) %></button>
      </form>
      <ul class="nav-ul">
        <% nav.forEach(function (it, i) { var on = i === onIdx; %>
          <% if (it.children) { %>
          <li class="has-sub">
            <button type="button" class="nav-top sub-btn <%= on ? 'on' : '' %>" aria-expanded="false">
              <span><b><%= it.label %></b><% if (it.en) { %><small><%= it.en %></small><% } %></span><%- icon('down', 14) %>
            </button>
            <ul class="sub">
              <% if (it.href) { %><li><a href="<%= it.href %>"><%= it.label %> (ทั้งหมด)</a></li><% } %>
              <% it.children.forEach(function (c) { %><li><a href="<%= c.href %>" <%= /^https?:/.test(c.href) ? 'target=_blank rel=noopener' : '' %>><%= c.label %></a></li><% }) %>
            </ul>
          </li>
          <% } else { %>
          <li><a class="nav-top <%= on ? 'on' : '' %>" href="<%= it.href %>" <%= on ? 'aria-current=page' : '' %>>
            <span><b><%= it.label %></b><% if (it.en) { %><small><%= it.en %></small><% } %></span></a></li>
          <% } %>
        <% }) %>
      </ul>
      <div class="nav-cta">
        <a class="btn btn-ghost" href="/portal"><%- icon('login', 18) %> เข้าสู่ระบบ</a>
        <a class="btn btn-accent" href="<%= applyUrl %>"><%- icon('graduation', 18) %> สมัครเรียน</a>
      </div>
    </div>
  </nav>
</header>

<% if (annKey) { %>
<div class="announce" id="announce" data-key="<%= annKey %>" role="region" aria-label="ประกาศสำคัญ">
  <div class="wrap announce-in">
    <span class="ann-tag"><%- icon('megaphone', 16) %> ประกาศสำคัญ</span>
    <p><%= S.announce_text %></p>
    <% if (S.announce_link) { %><a class="ann-more" href="<%= S.announce_link %>">ดูรายละเอียด <%- icon('arrow', 15) %></a><% } %>
    <button type="button" class="ann-x" aria-label="ปิดประกาศ"><%- icon('x', 16) %></button>
  </div>
</div>
<% } %>

<main id="main">
