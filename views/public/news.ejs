<%- include('_head') %>
<%- include('_pagehead', { heading: cat ? 'ข่าว' + cat : 'ข่าวสารและประกาศ', eyebrow: 'News & Announcements', lead: 'ทั้งหมด ' + total.toLocaleString('th-TH') + ' รายการ',
  crumbs: cat ? [['ข่าวสาร', '/news'], [cat]] : [['ข่าวสาร']] }) %>
<section class="sec">
  <div class="wrap">
    <div class="tabs" role="group" aria-label="เลือกหมวดข่าว">
      <a class="<%= cat === '' ? 'on' : '' %>" href="/news" <%= cat === '' ? 'aria-current=true' : '' %>>ทั้งหมด</a>
      <% categories.forEach(function (c) { %><a class="<%= cat === c ? 'on' : '' %>" href="/news?cat=<%= encodeURIComponent(c) %>" <%= cat === c ? 'aria-current=true' : '' %>><%= c %></a><% }) %>
    </div>
    <% if (!items.length) { %><p class="empty">ยังไม่มีข่าวในหมวดนี้</p><% } %>
    <div class="grid3"><% items.forEach(function (n) { %><%- include('_card', { n: n }) %><% }) %></div>
    <%- include('_pager', { page: page, pages: pages, href: function (n) { return '/news?' + (cat ? 'cat=' + encodeURIComponent(cat) + '&' : '') + 'page=' + n; } }) %>
  </div>
</section>
<%- include('_foot') %>
