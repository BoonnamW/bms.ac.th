<%- include('_head') %>
<section class="pagehead"><div class="wrap">
  <nav class="crumb" aria-label="breadcrumb"><a href="/">หน้าแรก</a> / <span>ติดต่อเรา</span></nav>
  <h1>ติดต่อเรา</h1>
</div></section>
<section class="sec"><div class="wrap two">
  <div>
    <% if (sent) { %><div class="alert ok">ส่งข้อความเรียบร้อยแล้ว ขอบคุณที่ติดต่อโรงเรียน เราจะตอบกลับโดยเร็วที่สุด</div><% } %>
    <% if (error) { %><div class="alert err"><%= error %></div><% } %>
    <form method="post" action="/contact" class="form">
      <input type="hidden" name="_ft" value="<%= ft %>">
      <div class="hp" aria-hidden="true"><label>เว็บไซต์ <input name="website" tabindex="-1" autocomplete="off"></label></div>
      <label>ชื่อ-นามสกุล *<input name="name" required maxlength="100"></label>
      <div class="row2">
        <label>อีเมล<input type="email" name="email" maxlength="120"></label>
        <label>โทรศัพท์<input name="phone" maxlength="30" inputmode="tel"></label>
      </div>
      <label>ข้อความ *<textarea name="message" rows="6" required maxlength="3000"></textarea></label>
      <label class="consent"><input type="checkbox" name="consent" value="1" required>
        ข้าพเจ้ายินยอมให้โรงเรียนเก็บและใช้ข้อมูลข้างต้นเพื่อติดต่อกลับ ตาม<a href="/p/privacy-policy" target="_blank" rel="noopener">นโยบายความเป็นส่วนตัว</a> *</label>
      <button class="btn btn-primary" type="submit">ส่งข้อความ <%- icon('arrow', 18) %></button>
    </form>
  </div>
  <aside class="side">
    <h3>ข้อมูลติดต่อ</h3>
    <ul class="fcontact dark">
      <li><%- icon('pin', 20) %><span><%= S.address %></span></li>
      <li><%- icon('phone', 20) %><span><%= S.phone %></span></li>
      <li><%- icon('mail', 20) %><span><%= S.email %></span></li>
      <li><%- icon('clock', 20) %><span><%= S.hours %></span></li>
    </ul>
  </aside>
</div></section>
<%- include('_foot') %>
