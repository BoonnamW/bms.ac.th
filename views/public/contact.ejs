<%- include('_head') %>
<%- include('_pagehead', { heading: 'ติดต่อเรา', eyebrow: 'Contact Us', lead: 'สอบถามข้อมูล นัดเยี่ยมชมโรงเรียน หรือแจ้งเรื่องร้องเรียน', crumbs: [['ติดต่อเรา']] }) %>
<section class="sec">
  <div class="wrap two">
    <div class="panel">
      <% if (sent) { %><div class="alert ok" role="status">ส่งข้อความเรียบร้อยแล้ว ขอบคุณที่ติดต่อโรงเรียน เจ้าหน้าที่จะติดต่อกลับโดยเร็วที่สุด</div><% } %>
      <% if (error) { %><div class="alert err" role="alert"><%= error %></div><% } %>
      <form method="post" action="/contact" class="form">
        <input type="hidden" name="_ft" value="<%= ft %>">
        <div class="hp" aria-hidden="true"><label>เว็บไซต์ <input name="website" tabindex="-1" autocomplete="off"></label></div>
        <label>ชื่อ-นามสกุล *<input name="name" required maxlength="100" autocomplete="name"></label>
        <div class="row2">
          <label>อีเมล<input type="email" name="email" maxlength="120" autocomplete="email"></label>
          <label>โทรศัพท์<input name="phone" maxlength="30" inputmode="tel" autocomplete="tel"></label>
        </div>
        <label>ข้อความ *<textarea name="message" rows="6" required maxlength="3000"><%= prefill %></textarea></label>
        <label class="consent"><input type="checkbox" name="consent" value="1" required>
          <span>ข้าพเจ้ายินยอมให้โรงเรียนเก็บและใช้ข้อมูลข้างต้นเพื่อติดต่อกลับ ตาม<a href="/p/privacy-policy" target="_blank" rel="noopener">นโยบายความเป็นส่วนตัว</a> *</span></label>
        <button class="btn btn-primary" type="submit">ส่งข้อความ <%- icon('arrow', 18) %></button>
      </form>
    </div>
    <aside class="side">
      <h3>ข้อมูลติดต่อ</h3>
      <ul class="fcontact dark">
        <% if (S.address) { %><li><%- icon('pin', 20) %><span><%= S.address %></span></li><% } %>
        <% if (S.phone) { %><li><%- icon('phone', 20) %><a href="tel:<%= S.phone.replace(/[^\d+]/g, '') %>"><%= S.phone %></a></li><% } %>
        <% if (S.email) { %><li><%- icon('mail', 20) %><a href="mailto:<%= S.email %>"><%= S.email %></a></li><% } %>
        <% if (S.hours) { %><li><%- icon('clock', 20) %><span><%= S.hours %></span></li><% } %>
        <% if (S.line_url) { %><li><%- icon('chat', 20) %><a href="<%= S.line_url %>" target="_blank" rel="noopener">LINE รับฟังความคิดเห็น / ร้องเรียน</a></li><% } %>
        <% if (S.facebook) { %><li><%- icon('facebook', 20) %><a href="<%= S.facebook %>" target="_blank" rel="noopener">Facebook โรงเรียน</a></li><% } %>
      </ul>
      <div class="fmap light">
        <button type="button" class="map-load" data-map="https://www.google.com/maps?q=<%= encodeURIComponent(S.map_query || S.school_name) %>&amp;output=embed">
          <%- icon('map', 28) %><span>แสดงแผนที่</span><small>โหลดจาก Google Maps เมื่อกดเท่านั้น</small>
        </button>
      </div>
    </aside>
  </div>
</section>
<%- include('_foot') %>
