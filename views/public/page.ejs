<%- include('_head') %>
<%
  var staffCount = staff ? (staff.head ? 1 : 0) + staff.members.length : 0;
  var lead = depts ? 'ทำเนียบบุคลากรตามกลุ่มสาระการเรียนรู้และฝ่าย' : staffCount ? 'บุคลากร ' + staffCount + ' คน' : '';
%>
<%- include('_pagehead', { heading: page.title, lead: lead, crumbs: page.menu_group ? [[page.menu_group], [page.title]] : [[page.title]] }) %>
<section class="sec">
  <div class="wrap <%= siblings.length > 1 ? 'two' : 'one' %>">
    <div class="main-col">
      <% if (staff || depts) { %><%- include('_staff') %><% } %>
      <% if (page.body || !(staff || depts)) { %><article class="prose <%= staff || depts ? 'mt' : '' %>"><%- page.body %></article><% } %>
    </div>
    <% if (siblings.length > 1) { %>
    <aside class="side">
      <h3><%= page.menu_group %></h3>
      <ul class="sidenav"><% siblings.forEach(function (s) { %><li><a class="<%= s.slug === page.slug ? 'on' : '' %>" href="/p/<%= s.slug %>" <%= s.slug === page.slug ? 'aria-current=page' : '' %>><%= s.title %></a></li><% }) %></ul>
    </aside>
    <% } %>
  </div>
</section>
<%- include('_foot') %>
