<%- include('_head') %>
<%
  var people = staff || depts;
  var count = staff ? (staff.head ? 1 : 0) + staff.members.length : 0;
  // หน้าทำเนียบ: เนื้อหาก่อนเส้นคั่น (<hr>) แสดงเหนือรายชื่อ ส่วนหลังเส้นคั่นแสดงใต้รายชื่อ
  var parts = people ? String(page.body || '').split(/<hr\s*\/?>/i) : [];
  var intro = (parts[0] || '').trim(), outro = parts.slice(1).join('<hr />').trim();
%>
<%- include('_pagehead', { heading: page.title, lead: count ? 'ทั้งหมด ' + count + ' คน' : '', crumbs: page.menu_group ? [[page.menu_group], [page.title]] : [[page.title]] }) %>
<section class="sec">
  <div class="wrap <%= siblings.length > 1 ? 'two' : 'one' %>">
    <div class="main-col">
      <% if (people) { %>
        <%- include('_staff', { part: 'top' }) %>
        <% if (intro) { %><article class="prose people-intro"><%- intro %></article><% } %>
        <%- include('_staff', { part: 'list' }) %>
        <% if (outro) { %><article class="prose people-outro"><%- outro %></article><% } %>
      <% } else { %>
        <article class="prose"><%- page.body %></article>
      <% } %>
    </div>
    <% if (siblings.length > 1) { %>
    <aside class="side">
      <h3><%= page.menu_group %></h3>
      <ul class="sidenav"><% siblings.forEach(function (s) { %><li><a class="<%= s.slug === page.slug ? 'on' : '' %>" href="/p/<%= s.slug %>" <%= s.slug === page.slug ? 'aria-current=page' : '' %>><%= s.title %></a></li><% }) %></ul>
    </aside>
    <% } %>
  </div>
</section>
<%- include('_foot') %>
