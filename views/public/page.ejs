<%- include('_head') %>
<%- include('_pagehead', { heading: page.title, crumbs: page.menu_group ? [[page.menu_group], [page.title]] : [[page.title]] }) %>
<section class="sec">
  <div class="wrap <%= siblings.length > 1 ? 'two' : 'one' %>">
    <article class="prose"><%- page.body %></article>
    <% if (siblings.length > 1) { %>
    <aside class="side">
      <h3><%= page.menu_group %></h3>
      <ul class="sidenav"><% siblings.forEach(function (s) { %><li><a class="<%= s.slug === page.slug ? 'on' : '' %>" href="/p/<%= s.slug %>" <%= s.slug === page.slug ? 'aria-current=page' : '' %>><%= s.title %></a></li><% }) %></ul>
    </aside>
    <% } %>
  </div>
</section>
<%- include('_foot') %>
