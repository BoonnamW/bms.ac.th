<%- include('_head') %>
<section class="pagehead">
  <div class="wrap">
    <nav class="crumb" aria-label="breadcrumb"><a href="/">หน้าหลัก</a> <span aria-hidden="true">/</span> <a href="/news">ข่าวสาร</a> <span aria-hidden="true">/</span> <a href="/news?cat=<%= encodeURIComponent(item.category) %>"><%= item.category %></a></nav>
    <h1><%= item.title %></h1>
    <p class="meta"><span class="chip"><%= item.category %></span><time><%- icon('calendar', 15) %> <%= thDate(item.created_at) %></time></p>
  </div>
</section>
<section class="sec">
  <div class="wrap two">
    <div class="main-col">
      <article class="prose">
        <% if (item.image) { %><img class="cover" src="/uploads/<%= item.image %>" alt="" <%- imgset(item.image, '(max-width: 860px) 100vw, 820px') %>><% } %>
        <%- item.body %>
      </article>
      <% if (photos) { %><%- include('_photos', { photos: photos, caption: item.title, heading: 'ภาพกิจกรรม', back: '/news/' + item.id }) %><% } %>
      <div class="share" aria-label="แบ่งปันข่าวนี้">
        <span>แบ่งปัน:</span>
        <a class="share-fb" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(shareUrl) %>" target="_blank" rel="noopener"><%- icon('facebook', 16) %> Facebook</a>
        <a class="share-line" href="https://social-plugins.line.me/lineit/share?url=<%= encodeURIComponent(shareUrl) %>" target="_blank" rel="noopener"><%- icon('chat', 16) %> LINE</a>
        <button type="button" class="share-copy" data-copy="<%= shareUrl %>"><%- icon('external', 16) %> <span>คัดลอกลิงก์</span></button>
      </div>
      <% if (related.length) { %>
      <h2 class="h-related">ข่าวที่เกี่ยวข้อง</h2>
      <div class="grid3"><% related.forEach(function (n) { %><%- include('_card', { n: n }) %><% }) %></div>
      <% } %>
    </div>
    <aside class="side">
      <h3>ข่าวล่าสุด</h3>
      <ul class="side-news"><% recent.forEach(function (r) { %>
        <li><a href="/news/<%= r.id %>"><% if (r.image) { %><img src="/uploads/<%= r.image %>" alt="" loading="lazy" <%- imgset(r.image, '64px') %>><% } %><span><%= r.title %><time><%= thDate(r.created_at) %></time></span></a></li><% }) %></ul>
      <a class="more" href="/news">ข่าวทั้งหมด <%- icon('arrow', 15) %></a>
    </aside>
  </div>
</section>
<%- include('_foot') %>
