<%- include('_head') %>
<% if (user.must_change) { %><div class="alert err">เพื่อความปลอดภัย กรุณาตั้งรหัสผ่านใหม่ก่อนใช้งานระบบ</div><% } %>
<% if (error) { %><div class="alert err" role="alert"><%= error %></div><% } %>
<% if (ok) { %><div class="alert ok">เปลี่ยนรหัสผ่านเรียบร้อยแล้ว (อุปกรณ์อื่นถูกออกจากระบบ)</div><% } %>
<form class="form narrow" method="post" action="/admin/password">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="fld"><label for="c">รหัสผ่านปัจจุบัน</label><input id="c" type="password" name="current" required autocomplete="current-password"></div>
  <div class="fld"><label for="n">รหัสผ่านใหม่</label><input id="n" type="password" name="next" required minlength="10" autocomplete="new-password"><small>อย่างน้อย 10 ตัวอักษร ประกอบด้วยตัวอักษรและตัวเลข</small></div>
  <div class="fld"><label for="k">ยืนยันรหัสผ่านใหม่</label><input id="k" type="password" name="confirm" required autocomplete="new-password"></div>
  <div class="formbar"><button class="btn">เปลี่ยนรหัสผ่าน</button></div>
</form>
<%- include('_foot') %>
