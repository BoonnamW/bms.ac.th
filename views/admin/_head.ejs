<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title><%= title %> | หลังบ้าน</title>
  <link rel="stylesheet" href="/css/fonts.css?v=<%= v %>">
  <link rel="stylesheet" href="/theme.css?v=<%= themeV %>">
  <link rel="stylesheet" href="/css/admin.css?v=<%= v %>">
  <script src="/js/admin.js?v=<%= v %>" defer></script>
</head>
<body class="<%= user ? 'app' : 'auth' %>">
<% if (user) { %>
<aside class="sb">
  <div class="sb-top">
    <a class="sb-brand" href="/admin"><%- icon('building', 22) %> <span>หลังบ้าน<small><%= S.school_name %></small></span></a>
    <button type="button" class="sb-toggle" aria-expanded="false" aria-controls="sbNav"><%- icon('menu', 20) %> เมนู</button>
  </div>
  <nav id="sbNav">
    <a href="/admin" class="<%= (path === '/admin' || path === '/admin/') ? 'on' : '' %>">แดชบอร์ด</a>
    <a href="/admin/arrange" class="<%= path.startsWith('/admin/arrange') ? 'on' : '' %>">จัดเมนูและหน้าแรก (ลากวาง)</a>
    <% [['เนื้อหา', ['news', 'journal_entries', 'journal_issues', 'events', 'awards', 'albums', 'pages', 'staff', 'gallery']], ['หน้าแรก', ['popups', 'slides', 'links', 'stats', 'programs', 'highlights']],
        ['เมนูและบริการ', ['menu_items', 'services']]].forEach(function (g) { %>
    <p><%= g[0] %></p>
    <% g[1].forEach(function (k) { %>
      <a href="/admin/<%= k %>" class="<%= path === '/admin/' + k || path.startsWith('/admin/' + k + '/') ? 'on' : '' %>"><%= entities[k].title %></a>
    <% }) %>
    <% }) %>
    <p>ระบบ</p>
    <a href="/admin/messages" class="<%= path.startsWith('/admin/messages') ? 'on' : '' %>"><%= entities.messages.title %></a>
    <a href="/admin/colors" class="<%= path.startsWith('/admin/colors') ? 'on' : '' %>">ปรับสีเว็บไซต์</a>
    <a href="/admin/settings" class="<%= path.startsWith('/admin/settings') ? 'on' : '' %>">ตั้งค่าเว็บไซต์</a>
    <a href="/admin/password" class="<%= path.startsWith('/admin/password') ? 'on' : '' %>">เปลี่ยนรหัสผ่าน</a>
  </nav>
  <div class="sb-foot">
    <a href="/" target="_blank" rel="noopener">ดูหน้าเว็บไซต์ ↗</a>
    <form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>ออกจากระบบ (<%= user.username %>)</button></form>
  </div>
</aside>
<main class="main">
  <header class="top"><h1><%= title %></h1></header>
<% } %>
