<% if (f.group) { %><h2 class="grp"><%= f.group %></h2><% } else { %>
<% var v = values[f.n]; if (v === null || v === undefined) v = ''; %>
<div class="fld <%= f.type === 'checkbox' ? 'chk' : '' %>">
  <% if (f.type === 'checkbox') { %>
    <label><input type="checkbox" name="<%= f.n %>" value="1" <%= (v && v !== '0') ? 'checked' : '' %>> <%= f.label %></label>
  <% } else { %>
    <label for="f_<%= f.n %>"><%= f.label %><%= f.req ? ' *' : '' %></label>
    <% if (readonly) { %>
      <div class="ro"><%= v %></div>
    <% } else if (f.type === 'textarea') { %>
      <textarea id="f_<%= f.n %>" name="<%= f.n %>" rows="4" <%= f.max ? 'maxlength=' + f.max : '' %>><%= v %></textarea>
    <% } else if (f.type === 'richtext') { %>
      <div class="rte" data-target="f_<%= f.n %>">
        <div class="rte-bar">
          <button type="button" data-cmd="formatBlock" data-val="h2" title="หัวข้อใหญ่">H2</button>
          <button type="button" data-cmd="formatBlock" data-val="h3" title="หัวข้อรอง">H3</button>
          <button type="button" data-cmd="formatBlock" data-val="p" title="ย่อหน้า">¶</button>
          <button type="button" data-cmd="bold" title="ตัวหนา"><b>B</b></button>
          <button type="button" data-cmd="italic" title="ตัวเอียง"><i>I</i></button>
          <button type="button" data-cmd="underline" title="ขีดเส้นใต้"><u>U</u></button>
          <button type="button" data-cmd="insertUnorderedList" title="รายการ">• รายการ</button>
          <button type="button" data-cmd="insertOrderedList" title="รายการลำดับ">1. รายการ</button>
          <button type="button" data-cmd="formatBlock" data-val="blockquote" title="คำพูด">❝</button>
          <button type="button" data-cmd="insertHorizontalRule" title="เส้นคั่น — หน้าทำเนียบ: เนื้อหาหลังเส้นนี้แสดงใต้รายชื่อ">― เส้นคั่น</button>
          <button type="button" data-cmd="createLink" title="แทรกลิงก์">🔗 ลิงก์</button>
          <button type="button" data-cmd="unlink" title="ลบลิงก์">ยกเลิกลิงก์</button>
          <button type="button" data-cmd="removeFormat" title="ล้างรูปแบบ">ล้าง</button>
        </div>
        <div class="rte-area" contenteditable="true" role="textbox" aria-multiline="true"><%- v %></div>
        <textarea id="f_<%= f.n %>" name="<%= f.n %>" hidden></textarea>
      </div>
    <% } else if (f.type === 'select') { %>
      <select id="f_<%= f.n %>" name="<%= f.n %>">
        <% if (!f.req) { %><option value="">— เลือก —</option><% } %>
        <% var labels = f.labels; f.options.forEach(function (o) { %><option value="<%= o %>" <%= String(v) === String(o) ? 'selected' : '' %>><%= labels && labels[o] !== undefined ? labels[o] : o %></option><% }) %>
      </select>
    <% } else if (f.type === 'image') { %>
      <% if (v) { %>
        <div class="imgcur"><img src="<%= /^https:\/\//.test(v) ? v : '/uploads/' + v %>" alt=""><label class="inl"><input type="checkbox" name="remove_<%= f.n %>" value="1"> ลบรูปนี้</label></div>
      <% } %>
      <input id="f_<%= f.n %>" type="file" name="<%= f.n %>" accept="image/jpeg,image/png,image/webp,image/gif">
    <% } else if (f.type === 'images') { var cur = pics(v); %>
      <% if (cur.length) { %>
      <ul class="imglist"><% cur.forEach(function (x) { %>
        <li><img src="/uploads/<%= x %>" alt="" loading="lazy"><label class="inl"><input type="checkbox" name="remove_images" value="<%= x %>"> ลบ</label></li><% }) %></ul>
      <% } %>
      <input id="f_<%= f.n %>" type="file" name="images" multiple accept="image/jpeg,image/png,image/webp,image/gif" data-max="12">
      <small>เลือกได้หลายรูปพร้อมกัน (รวมไม่เกิน 12 รูป) — ระบบย่อรูปให้อัตโนมัติก่อนอัปโหลด<%= cur.length ? ' · ตอนนี้มี ' + cur.length + ' รูป' : '' %></small>
    <% } else if (f.type === 'files') { var cur = docs(v); %>
      <% if (cur.length) { %>
      <ul class="doclist"><% cur.forEach(function (x) { %>
        <li><a href="/uploads/<%= x.f %>" target="_blank" rel="noopener"><%= x.n %></a> <label class="inl"><input type="checkbox" name="remove_files" value="<%= x.f %>"> ลบ</label></li><% }) %></ul>
      <% } %>
      <input id="f_<%= f.n %>" type="file" name="files" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx" data-doc>
      <small>PDF, Word, Excel, PowerPoint ไฟล์ละไม่เกิน 10 MB (รวมไม่เกิน 5 ไฟล์)</small>
    <% } else if (f.type === 'time') { %>
      <input id="f_<%= f.n %>" type="time" name="<%= f.n %>" value="<%= v || '' %>">
    <% } else if (f.type === 'coloropt') { %>
      <span class="copt"><input id="f_<%= f.n %>" type="color" name="<%= f.n %>" value="<%= v || '#888888' %>" class="colorin" <%= v ? '' : 'disabled' %>>
        <label class="inl"><input type="checkbox" name="<%= f.n %>_auto" value="1" data-copt="f_<%= f.n %>" <%= v ? '' : 'checked' %>> ใช้สีตามธีม</label></span>
    <% } else if (f.type === 'color') { %>
      <input id="f_<%= f.n %>" type="color" name="<%= f.n %>" value="<%= v %>" class="colorin">
    <% } else if (f.type === 'gdrive') { var ds = v && driveStatus(v); %>
      <input id="f_<%= f.n %>" type="url" name="<%= f.n %>" value="<%= v %>" inputmode="url" placeholder="https://drive.google.com/drive/folders/…" <%= f.req ? 'required' : '' %>>
      <% if (ds) { %><p class="dstat <%= ds.ok ? 'ok' : 'err' %>"><%= ds.ok ? 'เชื่อมต่อแล้ว · ' + ds.n.toLocaleString('th-TH') + ' รูป' : 'อ่านโฟลเดอร์ไม่ได้: ' + ds.error %> · อัปเดตล่าสุด <%= thDateTime(ds.at) %> · <a href="<%= v %>" target="_blank" rel="noopener">เปิดโฟลเดอร์</a></p><% } %>
    <% } else if (f.type === 'date') { %>
      <input id="f_<%= f.n %>" type="date" name="<%= f.n %>" value="<%= v || '' %>" <%= f.req ? 'required' : '' %>>
    <% } else if (f.type === 'datetime') { %>
      <input id="f_<%= f.n %>" type="datetime-local" name="<%= f.n %>" value="<%= v ? new Date(new Date(String(v).replace(' ', 'T') + 'Z').getTime() + 7 * 3600 * 1000).toISOString().slice(0, 16) : '' %>" <%= f.req ? 'required' : '' %>>
    <% } else { %>
      <input id="f_<%= f.n %>" name="<%= f.n %>" value="<%= v %>" <%= f.max ? 'maxlength=' + f.max : '' %>
        <%= f.type === 'number' ? 'inputmode=numeric' : '' %> <%= f.req ? 'required' : '' %>>
    <% } %>
    <% if (f.help) { %><small><%= f.help %></small><% } %>
  <% } %>
</div>
<% } %>
