<%- include('_head') %>
<div class="login">
  <div class="login-art">
    <h2><%= S.school_name %></h2>
    <p>ระบบจัดการเว็บไซต์โรงเรียน</p>
  </div>
  <form class="login-box" method="post" action="/admin/login" autocomplete="on">
    <h1>เข้าสู่ระบบ</h1>
    <p class="sub">สำหรับเจ้าหน้าที่ที่ได้รับอนุญาตเท่านั้น</p>
    <% if (error) { %><div class="alert err" role="alert"><%= error %></div><% } %>
    <input type="hidden" name="_lt" value="<%= lt %>">
    <label>ชื่อผู้ใช้<input name="username" required autofocus autocomplete="username" maxlength="60"></label>
    <label>รหัสผ่าน<input type="password" name="password" required autocomplete="current-password" maxlength="200"></label>
    <button class="btn">เข้าสู่ระบบ</button>
    <a class="back" href="/">← กลับสู่หน้าเว็บไซต์</a>
  </form>
</div>
<%- include('_foot') %>
